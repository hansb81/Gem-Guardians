{
 "_doc": "적 데이터. 몬스터 = 역할(roles) 스탯 + 스프라이트. 층은 10층씩 지역(chapters)으로 나뉘고, 그 층에는 그 지역 pool의 몬스터만(역할이 해금된 것만) 나온다. 10층마다 그 지역 boss. 101층부터 지역을 처음부터 반복(HP 배율은 계속 오름). 실제 수치 = 역할 기본값 x 층 배율(balance.json scaling).",
 "attackInterval": 1.0,
 "spriteDir": "assets/enemies/",
 "spriteRules": {
  "_doc": "파일 이름 = anim.walk의 {i}를 frames 값으로 바꾸고 .png. idle이 null이면 walk를 그대로 씀(Idle+Walk 한 줄짜리 시트, Default Anim). 실제 파일 이름이 다르면 이 패턴만 고친다.",
  "displayScale": 2,
  "anchor": "feet",
  "frameMs": {
   "walk": 110,
   "idle": 150
  },
  "facing": {
   "0x72": "right",
   "other": "right",
   "game": "right",
   "_doc": "원본이 보는 방향. 적은 왼쪽으로 걸으므로 right면 좌우 반전해서 그림. other 팩은 실제 이미지 보고 확인 필요"
  },
  "eliteScale": 1.25,
  "bossScaleIfSmall": {
   "maxFrameH": 24,
   "scale": 1.5,
   "_doc": "보스 이미지 높이가 24px 이하면 1.5배 더 크게, 이미 큰 스프라이트는 그대로"
  },
  "retouch": "색감 리터치(25색 팔레트, 외곽선 #0d0a10)는 추후 작업"
 },
