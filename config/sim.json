      "secondsPerMove": 1.8,
      "pick": "best",
      "bombAware": true
    },
    "normal": {
      "secondsPerMove": 2.5,
      "pick": "top3",
      "bombAware": true
    },
    "slow": {
      "secondsPerMove": 3.5,
      "pick": "top3",
      "bombAware": true,
      "_doc": "실제 느린 플레이어 기준(v8)"
    },
    "worst": {
      "secondsPerMove": 3.5,
      "pick": "random",
      "bombAware": false,
      "referenceOnly": true,
